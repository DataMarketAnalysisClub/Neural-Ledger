{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-ledger.local/contracts/outputs/statement.schema.json",
  "title": "Statement",
  "description": "data of GET /v1/statements/{id}: one imported bank statement with its lines. A statement that is not the caller's, or does not exist, is 404 with an INSUFFICIENT_DATA envelope (missing [\"statement\"]), the same for both. Descriptions are untrusted third-party text, with personal data replaced at import by placeholders (ADR-028). Money is integer minor units of `currency` (CLP: pesos; USD: cents); signs are the holder's: charges negative, money in positive, and a credit card's debt (opening and closing balance) negative.",
  "type": "object",
  "required": ["statement", "lines", "daily_balances"],
  "properties": {
    "statement": {"$ref": "#/$defs/summary"},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "posted_on", "description", "amount", "reference", "branch", "confidence", "kind", "section", "installment"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "posted_on": {"type": "string", "format": "date"},
          "description": {
            "type": "object",
            "description": "The line's text as the bank printed it, except personal data, replaced at import by placeholders such as [PERSON] (common/redaction.schema.json).",
            "required": ["untrusted_text"],
            "properties": {"untrusted_text": {"type": "string", "maxLength": 120}},
            "additionalProperties": false
          },
          "amount": {"type": "integer"},
          "reference": {"type": ["string", "null"]},
          "branch": {"type": ["string", "null"]},
          "confidence": {"type": ["number", "null"], "description": "Lowest OCR confidence over the line's cells; null when read from a text layer."},
          "kind": {
            "enum": ["purchase", "payment", "refund", "fee", "transfer_own", null],
            "description": "What the bank says the line is, when its layout says it (credit cards), or transfer_own when a checking layout's rule recognizes the holder's own money moving to their savings or card (ADR-024; posted as movement by rule). null: the sign decides."
          },
          "section": {"type": ["string", "null"], "description": "The printed subtotal the line belongs to (e.g. B, D, E on a card statement)."},
          "installment": {
            "type": ["object", "null"],
            "required": ["number", "total", "original_amount", "monthly_rate", "purchased_on"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "total": {"type": "integer", "minimum": 1},
              "original_amount": {"type": ["integer", "null"], "minimum": 0},
              "monthly_rate": {"type": ["number", "null"]},
              "purchased_on": {"type": ["string", "null"], "format": "date"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "daily_balances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["on", "balance"],
        "properties": {"on": {"type": "string", "format": "date"}, "balance": {"type": "integer"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "statement_id",
        "bank",
        "account_ref",
        "account_type",
        "currency",
        "period_start",
        "period_end",
        "source",
        "imported_at",
        "line_count",
        "total_debits",
        "total_credits",
        "opening_balance",
        "closing_balance",
        "provisional",
        "verified",
        "issues",
        "obligations"
      ],
      "properties": {
        "statement_id": {"type": "string"},
        "bank": {"type": "string", "description": "Code of the Bank layout that read it, e.g. santander_cl_cuentamatica."},
        "account_ref": {"type": "string", "pattern": "^\\*{4}[0-9A-Za-z]{0,4}$", "description": "Masked at import: only the last 4 digits (or the 4 characters a bank already left visible) are kept, e.g. ****3456 (ADR-028)."},
        "account_type": {
          "enum": ["checking", "savings", "credit_card"],
          "description": "From the layout that read it. A credit card statement carries obligations and its payments are never income."
        },
        "currency": {"type": "string"},
        "period_start": {"type": "string", "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "source": {"enum": ["text", "ocr", "xlsx"]},
        "imported_at": {"type": "string"},
        "line_count": {"type": "integer", "minimum": 0},
        "total_debits": {"type": "integer", "minimum": 0, "description": "Sum of charges read from the lines (positive)."},
        "total_credits": {"type": "integer", "minimum": 0},
        "opening_balance": {"type": ["integer", "null"], "description": "As printed; a card's previous billed debt, negative."},
        "closing_balance": {"type": ["integer", "null"], "description": "As printed; a card's billed debt, negative."},
        "provisional": {"type": "boolean", "description": "Unbilled movements (a card export of the open period): checked and stored, never posted to the ledger."},
        "verified": {"type": "boolean", "description": "True only if every printed total and daily balance matched the lines."},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "expected", "found", "on"],
            "properties": {
              "code": {
                "enum": [
                  "TOTAL_DEBITS",
                  "TOTAL_CREDITS",
                  "CLOSING_BALANCE",
                  "DAILY_BALANCE",
                  "OUT_OF_PERIOD",
                  "NO_SUMMARY",
                  "LOW_CONFIDENCE",
                  "SECTION_TOTAL",
                  "INSTALLMENT_SCHEDULE"
                ]
              },
              "message": {"type": "string"},
              "expected": {"type": ["integer", "null"]},
              "found": {"type": ["integer", "null"]},
              "on": {"type": ["string", "null"], "format": "date"}
            },
            "additionalProperties": false
          }
        },
        "obligations": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/obligations"}],
          "description": "Credit card statements only (null on a checking account, and on unbilled exports, which print no amount due)."
        }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "object",
      "description": "What the card statement says the holder owes. Positive magnitudes in the statement's currency; null when not printed. amount_due is the statement's closing debt, which reconciliation checks.",
      "required": [
        "amount_due",
        "minimum_due",
        "due_date",
        "credit_limit",
        "credit_used",
        "credit_available",
        "installments_remaining",
        "installments",
        "upcoming"
      ],
      "properties": {
        "amount_due": {"type": ["integer", "null"], "minimum": 0},
        "minimum_due": {"type": ["integer", "null"], "minimum": 0},
        "due_date": {"type": ["string", "null"], "format": "date"},
        "credit_limit": {"type": ["integer", "null"], "minimum": 0},
        "credit_used": {"type": ["integer", "null"], "minimum": 0},
        "credit_available": {"type": ["integer", "null"], "minimum": 0},
        "installments_remaining": {"type": "integer", "minimum": 0, "description": "Cuotas still to bill after this statement, computed from its cuota lines."},
        "installments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["line_index", "description", "number", "total", "installment_amount", "original_amount", "remaining_amount"],
            "properties": {
              "line_index": {"type": "integer", "minimum": 0},
              "description": {
                "type": "object",
                "required": ["untrusted_text"],
                "properties": {"untrusted_text": {"type": "string", "maxLength": 120}},
                "additionalProperties": false
              },
              "number": {"type": "integer", "minimum": 1},
              "total": {"type": "integer", "minimum": 2},
              "installment_amount": {"type": "integer", "minimum": 0},
              "original_amount": {"type": "integer", "minimum": 0},
              "remaining_amount": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "upcoming": {
          "type": "array",
          "description": "Cuotas due per later statement month, computed; when the bank prints its own schedule, reconciliation checks these against it (INSTALLMENT_SCHEDULE).",
          "items": {
            "type": "object",
            "required": ["month", "amount"],
            "properties": {"month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"}, "amount": {"type": "integer", "minimum": 0}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
