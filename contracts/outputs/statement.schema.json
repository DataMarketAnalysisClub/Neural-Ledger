{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-ledger.local/contracts/outputs/statement.schema.json",
  "title": "Statement",
  "description": "data of GET /v1/statements/{id}: one imported bank statement with its lines. Descriptions are untrusted third-party text. Money is integer minor units of `currency`; charges are negative.",
  "type": "object",
  "required": ["statement", "lines", "daily_balances"],
  "properties": {
    "statement": {"$ref": "#/$defs/summary"},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "posted_on", "description", "amount", "reference", "branch", "confidence"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "posted_on": {"type": "string", "format": "date"},
          "description": {"type": "object", "required": ["untrusted_text"], "properties": {"untrusted_text": {"type": "string", "maxLength": 120}}, "additionalProperties": false},
          "amount": {"type": "integer"},
          "reference": {"type": ["string", "null"]},
          "branch": {"type": ["string", "null"]},
          "confidence": {"type": ["number", "null"], "description": "Lowest OCR confidence over the line's cells; null when read from a text layer."}
        },
        "additionalProperties": false
      }
    },
    "daily_balances": {
      "type": "array",
      "items": {"type": "object", "required": ["on", "balance"], "properties": {"on": {"type": "string", "format": "date"}, "balance": {"type": "integer"}}, "additionalProperties": false}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["statement_id", "bank", "account_ref", "currency", "period_start", "period_end", "source", "imported_at", "line_count", "total_debits", "total_credits", "opening_balance", "closing_balance", "verified", "issues"],
      "properties": {
        "statement_id": {"type": "string"},
        "bank": {"type": "string", "description": "Code of the Bank layout that read it, e.g. santander_cl_cuentamatica."},
        "account_ref": {"type": "string"},
        "currency": {"type": "string"},
        "period_start": {"type": "string", "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "source": {"enum": ["text", "ocr"]},
        "imported_at": {"type": "string"},
        "line_count": {"type": "integer", "minimum": 0},
        "total_debits": {"type": "integer", "minimum": 0, "description": "Sum of charges read from the lines (positive)."},
        "total_credits": {"type": "integer", "minimum": 0},
        "opening_balance": {"type": ["integer", "null"], "description": "As printed."},
        "closing_balance": {"type": ["integer", "null"], "description": "As printed."},
        "verified": {"type": "boolean", "description": "True only if every printed total and daily balance matched the lines."},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "expected", "found", "on"],
            "properties": {
              "code": {"enum": ["TOTAL_DEBITS", "TOTAL_CREDITS", "CLOSING_BALANCE", "DAILY_BALANCE", "OUT_OF_PERIOD", "NO_SUMMARY", "LOW_CONFIDENCE"]},
              "message": {"type": "string"},
              "expected": {"type": ["integer", "null"]},
              "found": {"type": ["integer", "null"]},
              "on": {"type": ["string", "null"], "format": "date"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
