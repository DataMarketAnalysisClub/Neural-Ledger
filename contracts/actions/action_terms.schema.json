{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-ledger.local/contracts/actions/action_terms.schema.json",
  "title": "ActionTerms",
  "description": "The confirmation contract (Spec v0 section 5). The UI shows exactly these terms and execution must match them exactly. The amount always comes from a stored plan snapshot, never from model text.",
  "type": "object",
  "required": ["action", "amount", "currency", "frequency", "source_account", "destination", "effective_date"],
  "properties": {
    "action": {"enum": ["create_savings_rule"]},
    "amount": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "frequency": {"enum": ["monthly"]},
    "source_account": {"type": "string", "examples": ["checking"]},
    "destination": {"type": "string", "examples": ["sandbox_savings"]},
    "effective_date": {"type": "string", "format": "date"}
  },
  "additionalProperties": false,
  "examples": [
    {"action": "create_savings_rule", "amount": 100000, "currency": "CLP", "frequency": "monthly", "source_account": "checking", "destination": "sandbox_savings", "effective_date": "2027-01-01"}
  ]
}
