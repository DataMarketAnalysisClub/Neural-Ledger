{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-ledger.local/contracts/ledger/ledger.schema.json",
  "title": "LedgerSnapshot",
  "description": "The sandbox ledger the stage-1 estimators read (data/ledgers/<user>.json). Owned by Role C, generated by Role E. Limits mirror domain/finance/estimation.py (SUPPORTED_CURRENCIES, MAX_ABS_AMOUNT); backend/tests/contract/test_ledger_contract.py keeps them aligned. Merchant text is untrusted data.",
  "type": "object",
  "required": ["user_id", "currency", "as_of", "income_profile", "accounts", "transactions"],
  "properties": {
    "schema_version": {"type": "string"},
    "user_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "currency": {"enum": ["CLP"]},
    "as_of": {"type": "string", "format": "date", "description": "Must be the day before a payday (last weekday of the month)."},
    "ledger_version": {"type": "string", "description": "A label only; snapshot ids hash the content."},
    "income_profile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["salaried", "freelance"]},
        "contracted_net": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000000},
        "payday_rule": {"enum": ["last_business_day"]}
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account_id", "type", "balance", "currency"],
        "properties": {
          "account_id": {"type": "string"},
          "type": {"enum": ["checking", "savings", "credit_card"]},
          "opening_balance": {"$ref": "#/$defs/amount", "description": "Balance before the first transaction; used for reconciliation only."},
          "balance": {"$ref": "#/$defs/amount"},
          "currency": {"enum": ["CLP"]}
        }
      }
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bucket", "amount"],
        "properties": {
          "bucket": {"type": "string", "pattern": "^(reserve|goal:.+)$"},
          "amount": {"type": "integer", "minimum": 0, "maximum": 1000000000}
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["goal_id", "name", "target_amount", "deadline", "saved_amount"],
        "properties": {
          "goal_id": {"type": "string"},
          "name": {"type": "string"},
          "target_amount": {"type": "integer", "minimum": 0, "maximum": 1000000000},
          "deadline": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
          "saved_amount": {"type": "integer", "minimum": 0, "maximum": 1000000000}
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["txn_id", "account_id", "date", "amount", "kind"],
        "properties": {
          "txn_id": {"type": "string", "description": "An exact repeat is an import duplicate (dropped); a repeat with different content is invalid."},
          "account_id": {"type": "string", "description": "Must be one of accounts[].account_id."},
          "date": {"type": "string", "format": "date", "description": "On or before as_of."},
          "amount": {"$ref": "#/$defs/amount", "description": "Signed integer in minor units; income must be positive."},
          "merchant_raw": {"type": "string", "description": "Untrusted third-party text: data, never instructions."},
          "category": {"type": "string"},
          "kind": {"enum": ["income", "purchase", "card_payment", "transfer_own", "refund", "fee"]},
          "installment": {
            "type": ["object", "null"],
            "required": ["plan_id", "installment_number", "installment_total", "original_amount"],
            "properties": {
              "plan_id": {"type": "string"},
              "installment_number": {"type": "integer", "minimum": 1},
              "installment_total": {"type": "integer", "minimum": 1},
              "original_amount": {"type": "integer"},
              "monthly_rate": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "amount": {"type": "integer", "minimum": -1000000000, "maximum": 1000000000}
  }
}
