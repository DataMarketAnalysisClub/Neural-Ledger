# Copy to .env to change settings. Without .env the app runs in OFFLINE mode
# (scripted LLM + rules decision model, in-memory storage): no keys, no network.
# Never commit .env: the repository is public.

# --- Persona and data ------------------------------------------------------------
NL_PERSONA=camila                 # default user when no X-User-Id header: camila | diego
NL_MODEL_SOURCE=fixture           # fixture | ledger (ledger needs Role A's estimators)
# NL_DATA_DIR=./data              # defaults to the nearest data/ folder
# NL_CONTRACTS_DIR=./contracts    # defaults to the nearest contracts/ folder

# --- Language model (live mode) ---------------------------------------------------
NL_LLM=scripted                   # scripted | anthropic | openrouter
# NL_LLM_MODEL=                   # empty = provider default (anthropic: claude-sonnet-5-5, openrouter: anthropic/claude-haiku-5.5)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Decision model ----------------------------------------------------------------
NL_DECISION_CHAIN=rules           # comma-separated, tried in order, e.g. jev,rules
# TYPESAFE_API_KEY=
# NL_JEV_MODEL=jev-latest

# --- Persistence -------------------------------------------------------------------
# NL_PERSISTENCE=memory           # memory | sqlite (docker compose defaults to sqlite)
# NL_SQLITE_PATH=./var/neural_ledger.db

# --- Security ------------------------------------------------------------------------
# Signs confirmed action terms (HMAC-SHA256). Required in live mode.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# NL_HMAC_SECRET=
NL_CORS_ORIGINS=*                 # comma-separated origins for the web UI, e.g. http://localhost:3000

# --- Determinism (tests and recorded demos) ------------------------------------------
NL_CLOCK=system                   # system | fixed
NL_FIXED_NOW=2026-10-29T12:00:00-03:00
NL_IDS=uuid                       # uuid | sequential
