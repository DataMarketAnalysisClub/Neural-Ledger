# Copy to .env to change settings. Without .env the app runs in OFFLINE mode
# (scripted LLM + rules decision model, in-memory storage): no keys, no network.
# Never commit .env: the repository is public. Keep every secret below empty here.
# Format: one KEY=value per line, no inline comments (tests/unit/test_env_example.py checks it).

# --- Identity ----------------------------------------------------------------------
# demo: the X-User-Id header (or NL_PERSONA) picks the user and profiles are read-only (local runs, recorded demos)
# accounts: sign-up and sign-in with an HttpOnly nl_session cookie; X-User-Id is rejected (docker compose sets this)
NL_AUTH=demo
# Exact origins allowed to send POST, PUT or DELETE in accounts mode, comma-separated; never * (add your public URL)
NL_APP_ORIGINS=http://localhost:3000,http://localhost:5173
# Secure flag on the session cookie: auto (only when served over https) | true | false
NL_COOKIE_SECURE=auto
# accounts mode: allow POST /v1/auth/demo-session for the shared camila and diego personas: true | false
NL_DEMO_PERSONAS=true

# --- Persona and data ------------------------------------------------------------
# Demo mode only: default user when no X-User-Id header: camila | diego
NL_PERSONA=camila
# fixture | ledger (ledger runs Role A's stage-1 estimators over data/ledgers)
NL_MODEL_SOURCE=fixture
# Empty = nearest data/ and contracts/ folders
NL_DATA_DIR=
NL_CONTRACTS_DIR=

# --- Language model (live mode) ---------------------------------------------------
# scripted | openrouter (anthropic still works but is deprecated, ADR-027)
NL_LLM=scripted
# Empty = provider default (anthropic: claude-sonnet-5-5, openrouter: anthropic/claude-haiku-5.5)
NL_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Decision model ----------------------------------------------------------------
# Comma-separated, tried in order, e.g. jev,rules. jev runs through OPENROUTER_API_KEY; rules is the offline floor
NL_DECISION_CHAIN=rules
# Only for calling Jev directly at TypeSafe; leave empty to use OpenRouter
TYPESAFE_API_KEY=
# Pinned version; jev-latest is an alias that moves when TypeSafe ships a release
NL_JEV_MODEL=jev-1.13.0

# --- Persistence -------------------------------------------------------------------
# memory | sqlite (docker compose overrides NL_PERSISTENCE and NL_SQLITE_PATH)
NL_PERSISTENCE=memory
# Relative to where the API runs: backend/var/neural_ledger.db with the make targets
NL_SQLITE_PATH=./var/neural_ledger.db
# Seals statement and transaction payloads in SQLite (AES-GCM, G11). Required in live mode with SQLite.
# Empty offline: a random key is created once in <NL_SQLITE_PATH>.key (git-ignored); losing it loses the data.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
NL_DATA_KEY=

# --- Bank statements ---------------------------------------------------------------
# Text-layer PDFs need the `pdf` extra; scans and photos also need `ocr` and EasyOCR weights.
# EasyOCR weights folder; empty = ~/.EasyOCR/model
NL_OCR_MODEL_DIR=
# Verified statements are posted to the transaction ledger with spending categories (`ml` extra).
# Classifiers, comma-separated, tried in order; see CLASSIFIERS in backend/src/neural_ledger/bootstrap/container.py
# Live: jev,naive_bayes (Jev through OPENROUTER_API_KEY, naive Bayes when Jev is down). jev sends each statement
# line's text, already redacted, to Jev (ADR-032; read docs/SECURITY.md first). naive_bayes alone stays offline.
NL_CLASSIFIER=naive_bayes
# Personal data is removed at import by built-in rules, always. Optional second layer: none | azure
# azure sends the text of every statement line to Azure AI Language (Microsoft); read docs/SECURITY.md first
NL_PII_DETECTOR=none
# Your Language resource, e.g. https://<resource>.cognitiveservices.azure.com
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_KEY=

# --- Security ------------------------------------------------------------------------
# Signs confirmed action terms (HMAC-SHA256). Live mode (a real NL_LLM, or jev in NL_DECISION_CHAIN or NL_CLASSIFIER) refuses to start without one.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
NL_HMAC_SECRET=
# Comma-separated origins allowed to call the API from a browser. "*" opens the API to any origin and is never the default.
NL_CORS_ORIGINS=http://localhost:3000
# Per-caller and per-IP request budgets (429 over them; G07). off only for load tests.
NL_RATE_LIMIT=on

# --- Determinism (tests and recorded demos) ------------------------------------------
# system | fixed
NL_CLOCK=system
NL_FIXED_NOW=2026-10-29T12:00:00-03:00
# uuid | sequential
NL_IDS=uuid
