# Copy to .env to change settings. Without .env the app runs in OFFLINE mode
# (scripted LLM + rules decision model, in-memory storage): no keys, no network.
# Never commit .env: the repository is public. Keep every secret below empty here.
# Format: one KEY=value per line, no inline comments (tests/unit/test_env_example.py checks it).

# --- Identity ----------------------------------------------------------------------
# demo: the X-User-Id header (or NL_PERSONA) picks the user and profiles are read-only (local runs, recorded demos)
# accounts: sign-up and sign-in with an HttpOnly nl_session cookie; X-User-Id is rejected (docker compose sets this)
NL_AUTH=demo
# Exact origins allowed to send POST, PUT or DELETE in accounts mode, comma-separated; never * (add your public URL)
NL_APP_ORIGINS=http://localhost:3000,http://localhost:5173
# Secure flag on the session cookie: auto (only when served over https) | true | false
NL_COOKIE_SECURE=auto
# accounts mode: allow POST /v1/auth/demo-session for the shared camila and diego personas: true | false
NL_DEMO_PERSONAS=true
# accounts mode: sign-up email domain checks, comma-separated, in order: disposable (offline blocklist of temporary
# inboxes such as yopmail) | dns (the domain must exist and receive mail; asks DNS, lets the email through on a timeout) | none
NL_EMAIL_CHECKS=disposable

# --- Persona and data ------------------------------------------------------------
# Demo mode only: default user when no X-User-Id header: camila | diego
NL_PERSONA=camila
# fixture | ledger (ledger runs Role A's stage-1 estimators over data/ledgers)
NL_MODEL_SOURCE=fixture
# Empty = nearest data/ and contracts/ folders
NL_DATA_DIR=
NL_CONTRACTS_DIR=

# --- Language model (live mode) ---------------------------------------------------
# scripted | openrouter (anthropic still works but is deprecated, ADR-027)
NL_LLM=scripted
# Empty = provider default (anthropic: claude-sonnet-5-5, openrouter: anthropic/claude-haiku-5.5)
NL_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Decision model ----------------------------------------------------------------
# Comma-separated, tried in order, e.g. jev,rules. jev runs through OPENROUTER_API_KEY; rules is the offline floor
NL_DECISION_CHAIN=rules
# Only for calling Jev directly at TypeSafe; leave empty to use OpenRouter
TYPESAFE_API_KEY=
# Pinned version; jev-latest is an alias that moves when TypeSafe ships a release
NL_JEV_MODEL=jev-1.14-20261014

# --- Persistence -------------------------------------------------------------------
# memory | sqlite (docker compose overrides NL_PERSISTENCE and NL_SQLITE_PATH)
NL_PERSISTENCE=memory
# Relative to where the API runs: backend/var/neural_ledger.db with the make targets
NL_SQLITE_PATH=./var/neural_ledger.db
# Seals personal data in SQLite (AES-256-GCM, G11). Read in this order: a key file (NL_DATA_KEY_FILE, or the Docker
# secret /run/secrets/nl_data_key when it exists), then NL_DATA_KEY. Required in live mode and in deployed mode.
# Empty in a local run: a random key is created once in <NL_SQLITE_PATH>.key (git-ignored), with a loud warning,
# because it sits on the data volume. Losing the key loses the data.
# Generate one with: openssl rand -hex 32   (or: python -c "import secrets; print(secrets.token_hex(32))")
NL_DATA_KEY=
# A file holding the key (64 hex characters); empty = /run/secrets/nl_data_key if mounted (docker-compose.data-key.yml)
NL_DATA_KEY_FILE=
# local | deployed. deployed (a server others can reach) refuses to start without a data key, with a key file on the
# data volume, while the old <NL_SQLITE_PATH>.key exists, or with the development NL_HMAC_SECRET
NL_DEPLOYMENT=local

# --- Bank statements ---------------------------------------------------------------
# Text-layer PDFs need the `pdf` extra; scans and photos also need `ocr` and EasyOCR weights.
# EasyOCR weights folder; empty = ~/.EasyOCR/model
NL_OCR_MODEL_DIR=
# Verified statements are posted to the transaction ledger with spending categories (`ml` extra).
# Classifiers, comma-separated, tried in order; see CLASSIFIERS in backend/src/neural_ledger/bootstrap/container.py
# Live: jev,naive_bayes (Jev through OPENROUTER_API_KEY, naive Bayes when Jev is down). jev sends each statement
# line's text, already redacted, to Jev (ADR-032; read docs/SECURITY.md first). naive_bayes alone stays offline.
NL_CLASSIFIER=naive_bayes
# Personal data is removed at import by built-in rules, always. Optional second layer: none | azure
# azure sends the text of every statement line to Azure AI Language (Microsoft); read docs/SECURITY.md first
NL_PII_DETECTOR=none
# Your Language resource, e.g. https://<resource>.cognitiveservices.azure.com
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_KEY=
# Concept cards that explain financial terms (ADR-040). Indexes, comma-separated, tried in order; see KNOWLEDGE_BASES
# in backend/src/neural_ledger/bootstrap/container.py. lexical (BM25, offline) is the default and the fallback.
# chroma,lexical: ChromaDB with a multilingual embedding model (`rag` extra); the question is embedded locally,
# only the model's weights are downloaded (~240 MB, once, into NL_KB_DIR).
NL_KNOWLEDGE_BASE=lexical
# Where the model's weights (and, without NL_KB_URL, the embedded Chroma index) live
NL_KB_DIR=./var/chroma
# A Chroma server instead of the embedded index, e.g. http://localhost:8001; docker compose sets http://chroma:8000
NL_KB_URL=
# docker compose only: extras the api image installs; add rag to use the chroma container (--profile rag)
# NL_API_EXTRAS=api,pdf,ml,rag
# Any fastembed text model; empty = sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (es, en and more)
NL_KB_EMBEDDING_MODEL=

# --- Investment accounts (ADR-044) ---------------------------------------------------
# Who reads an investment account a user links in the app: fixture | fintual
# fixture links a synthetic sandbox account with no network (CI, docker compose, the public demo).
# fintual calls the Fintual API with the email and password the user types (read docs/SECURITY.md first).
# Live mode; NL_DEPLOYMENT=deployed refuses it: the public demo holds no real accounts (ADR-038).
NL_INVESTMENTS=fixture
# The Fintual API (https only; documented at https://fintual.cl/api-docs/index.html)
NL_FINTUAL_BASE_URL=https://fintual.cl/api
# Local diagnosis only: log the sign-in answer's field names and, when the goals are refused, try the other known
# ways of presenting the token, logging each HTTP status. Never a value or a credential.
NL_FINTUAL_DIAGNOSTICS=false
# --- Read-only connections (ADR-047) ---------------------------------------------------
# fixture: a synthetic investment MCP server and a synthetic bank, offline. live: the MCP servers users add
# (https, public addresses only) and their bank through Fintoc; read docs/SECURITY.md first.
NL_CONNECTORS=fixture
# NL_DEPLOYMENT=deployed turns live connectors off unless this is true (the public demo holds nothing real).
NL_CONNECTORS_LIVE=false
# Local development only: lets an MCP server on http://localhost be added. Refused with NL_DEPLOYMENT=deployed.
NL_MCP_ALLOW_PRIVATE=false
# Fintoc (Movements API) keys for a live bank connection; without them the bank option is hidden in live mode.
FINTOC_SECRET_KEY=
FINTOC_PUBLIC_KEY=

# --- Security ------------------------------------------------------------------------
# Signs confirmed action terms (HMAC-SHA256). Live mode (a real NL_LLM, or jev in NL_DECISION_CHAIN or NL_CLASSIFIER) refuses to start without one.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
NL_HMAC_SECRET=
# Comma-separated origins allowed to call the API from a browser. "*" opens the API to any origin and is never the default.
NL_CORS_ORIGINS=http://localhost:3000
# Per-caller and per-IP request budgets (429 over them; G07). off only for load tests.
NL_RATE_LIMIT=on

# --- Determinism (tests and recorded demos) ------------------------------------------
# system | fixed
NL_CLOCK=system
NL_FIXED_NOW=2026-10-29T12:00:00-03:00
# uuid | sequential
NL_IDS=uuid
